OPENAI_API_KEY=replace-with-your-openai-api-key

# MedForge <-> TrueForge
TRUEFORGE_URL=http://localhost:8790
USE_TRUEFORGE_AGENTS=true

# Twilio Messaging / Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_DEFAULT_TO_NUMBER=+1xxxxxxxxxx
# Public HTTPS base (ngrok/cloudflared) so Twilio can POST speech to MedForge
TWILIO_WEBHOOK_BASE_URL=https://your-tunnel.example.com

# Optional openFDA key
# OPENFDA_API_KEY=
